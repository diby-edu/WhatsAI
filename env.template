# =============================================
# WazzapAI - Environment Variables Template
# =============================================
# Copy this file to .env.local and fill in your values

# =============================================
# SUPABASE (Required)
# =============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================
# OPENAI (Required for AI responses)
# =============================================
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# =============================================
# CINETPAY (Required for payments)
# =============================================
# Get these from: https://my.cinetpay.com/
CINETPAY_SITE_ID=your-site-id
CINETPAY_API_KEY=your-api-key
CINETPAY_SECRET_KEY=your-secret-key
# Set to 'sandbox' for testing, 'live' for production
CINETPAY_MODE=sandbox

# =============================================
# PAYSTACK (Optional - alternate online payments)
# =============================================
# Get these from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key

# =============================================
# FEEXPAY (Optional - alternate online/mobile money payments)
# =============================================
# Get these from: https://dashboard.feexpay.me/
FEEXPAY_API_KEY=fp_your-feexpay-api-key
FEEXPAY_SHOP_ID=your-feexpay-shop-id
# Base URL for initialization (default recommended):
FEEXPAY_API_BASE_URL=https://api-v2.feexpay.me/api
# Base URL for status checks (default recommended):
FEEXPAY_STATUS_BASE_URL=https://api.feexpay.me/api
# Network code examples:
# mtn_bj, moov_bj, celtiis_bj, coris, togocom_tg, moov_tg,
# mtn_ci, moov_ci, wave_ci, orange_ci, mtn_cg, orange_sn, wave_sn, free_sn
FEEXPAY_DEFAULT_NETWORK=wave_ci
# Required only for OTP networks (e.g. orange_sn, coris)
FEEXPAY_DEFAULT_OTP=
# Optional webhook signature secret (recommended)
FEEXPAY_WEBHOOK_SECRET=

# =============================================
# APP CONFIGURATION
# =============================================
# Your app URL (without trailing slash)
NEXT_PUBLIC_APP_URL=https://wazzapai.com
NEXT_PUBLIC_APP_NAME=WazzapAI

# =============================================
# WHATSAPP SESSIONS (Optional)
# =============================================
# Directory to store WhatsApp sessions
# Default is ./.whatsapp-sessions
WHATSAPP_SESSION_PATH=./.whatsapp-sessions

# =============================================
# EMAIL (Optional - for transactional emails)
# =============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@wazzapai.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=WazzapAI
SMTP_FROM_EMAIL=noreply@wazzapai.com

# =============================================
# ANALYTICS (Optional)
# =============================================
# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# =============================================
# ADDITIONAL SERVICES (Optional)
# =============================================
# Sentry for error tracking
SENTRY_DSN=your-sentry-dsn

# =============================================
# DEPLOYMENT
# =============================================
# Set to 'production' in production environment
NODE_ENV=development
